# Quote form → email (https://resend.com, free tier). Verify merrier.coffee in Resend first.
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Merrier Website <quotes@merrier.coffee>"
QUOTE_TO_EMAIL=info@merrier.coffee

# Optional spam protection (https://dash.cloudflare.com → Turnstile, free). Leave blank to use the honeypot only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: public Google Calendar "Secret address in iCal format" or public .ics URL.
GCAL_ICS_URL=

# Keystatic GitHub mode (production). Generated by the one-time setup in README → Deploying, step 3.
NEXT_PUBLIC_KEYSTATIC_REPO=mjdye/merriercoffee
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
